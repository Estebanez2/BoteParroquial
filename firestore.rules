      let priorMonths=before==null ? {} : before.get('refundedMonths',{});
      return request.auth!=null && !exists(path) && op.incomeId==id && op.actorUid==request.auth.uid && op.createdAt==request.time
        && income.type=='income' && income.status=='active'
        && (op.originalMovementId==null || oldRefund(groupId,op)==null || get(movementPath(groupId,op.originalMovementId)).data.personId==income.personId)
        && (op.targetMovementId==null || newRefund(groupId,op)==null || getAfter(movementPath(groupId,op.targetMovementId)).data.personId==income.personId
          && getAfter(movementPath(groupId,op.targetMovementId)).data.occurredAt>=income.occurredAt)
        && data.keys().hasOnly(['allocatedCents','refundedCents','refundedAssignedCents','refundedMonths','revision','lastAllocationId','lastAuditEventId','lastRefundOperationId','updatedBy','updatedAt'])
        && data.allocatedCents is int && data.refundedCents is int && data.allocatedCents>=0 && data.refundedCents>=0
        && data.refundedAssignedCents is int && data.refundedAssignedCents>=0 && data.refundedAssignedCents<=data.allocatedCents
