    }
    function refundCreateLink(groupId,id,data) {
      return data.get('refund',null)==null && data.get('lastRefundOperationId',null)==null
        || (refundMovementLink(groupId,id,data,data.get('correctionOfMovementId',null)==null ? 'create' : 'correct',true));
    }
    function oldRefund(groupId,op) {
      return op.previousRefund;
    }
    function newRefund(groupId,op) {
      return op.refund;
    }
    function refundOriginalTransition(groupId,id,op) {
      let path=movementPath(groupId,op.originalMovementId);
      let before=get(path).data;
      let after=getAfter(path).data;
      return before.status=='active' && before.get('refund',null)==op.previousRefund
        && op.previousAmountCents==(op.previousRefund==null ? 0 : before.amountCents)
