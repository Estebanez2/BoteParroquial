rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt', 'lastSignInAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 256
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 320))
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('lastSignInAt' in data) || data.lastSignInAt == null || data.lastSignInAt is timestamp);
    }
    match /users/{uid} {
      allow get: if ownsProfile(uid);
      allow create: if ownsProfile(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSignInAt == request.time;
      allow update: if ownsProfile(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSignInAt == request.time;
      allow list, delete: if false;
    }
    function activeMember(groupId) {
      let membership = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return request.auth != null
        && exists(membership)
        && get(membership).data.uid == request.auth.uid
        && get(membership).data.status == 'active'
        && get(membership).data.role in ['owner', 'admin', 'member']
        && get(/databases/$(database)/documents/groups/$(groupId)).data.isActive == true;
    }
    // Discovery is restricted to one's own membership records, never group data.
    // The uid filter in the collection-group query is mandatory.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /groups/{groupId} {
      allow get: if activeMember(groupId);
      allow list, create, update, delete: if false;
      match /members/{uid} {
        allow read: if activeMember(groupId);
        // Controlled provisioning only in Phase 2. No client can grant roles.
        allow write: if false;
      }
    }
    // Persons, money and future collections remain closed until their phases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
