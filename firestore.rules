        && data.refundedAssignedCents==(before==null ? 0 : before.get('refundedAssignedCents',0))-op.previousAssignedCents+op.assignedCents
        && data.refundedMonths is map && data.refundedMonths.diff(priorMonths).affectedKeys().hasOnly(op.changes)
        && refundMonthChange(groupId,op,priorMonths,data.refundedMonths,income.personId,0)
        && refundMonthChange(groupId,op,priorMonths,data.refundedMonths,income.personId,1)
