    function refundPath(groupId,id) { return /databases/$(database)/documents/groups/$(groupId)/auditEvents/$(id); }
    function refundAssigned(plan,keys) {
      return (keys.size()>0 ? plan.parts.get(keys[0],0) : 0)+(keys.size()>1 ? plan.parts.get(keys[1],0) : 0)
        +(keys.size()>2 ? plan.parts.get(keys[2],0) : 0)+(keys.size()>3 ? plan.parts.get(keys[3],0) : 0);
    }
    function validRefundPlan(plan) {
      return plan is map && plan.keys().hasOnly(['incomeId','unallocatedCents','parts'])
        && plan.incomeId is string && plan.unallocatedCents is int && plan.unallocatedCents>=0
        && plan.parts is map && plan.parts.size()<=4;
