        && op.changes is list && op.changes.size()<=4 && !op.changes.hasAny([null]) && op.changes.toSet().size()==op.changes.size()
        && (old==null || old.parts.keys().hasOnly(op.changes)) && (next==null || next.parts.keys().hasOnly(op.changes))
        && refundMonthChange(groupId,op,previous,balance.refundedMonths,getAfter(movementPath(groupId,op.incomeId)).data.personId,2);
    }
    function refundMonthChange(groupId,op,prior,next,personId,i) {
      let key=i<op.changes.size() ? op.changes[i] : null;
      let old=key==null || op.previousRefund==null ? 0 : op.previousRefund.parts.get(key,0);
      let amount=key==null || op.refund==null ? 0 : op.refund.parts.get(key,0);
      let allocation=key==null ? null : get(allocationPath(groupId,op.incomeId+'_'+key)).data;
      let returned=key==null ? 0 : next.get(key,0);
      return key==null || (allocation.personId==personId && allocation.movementId==op.incomeId && string(allocation.month)==key
