    }
    function validRefundOperation(groupId,id,op) {
      let old=oldRefund(groupId,op);
      let next=newRefund(groupId,op);
      let balance=getAfter(allocationBalancePath(groupId,op.incomeId)).data;
      let previous=exists(allocationBalancePath(groupId,op.incomeId)) ? get(allocationBalancePath(groupId,op.incomeId)).data.get('refundedMonths',{}) : {};
      // The mandatory movement write checks managesPersons; every witness is new in this commit.
      return request.auth!=null && op.keys().hasOnly(['kind','incomeId','originalMovementId','targetMovementId',
          'previousAmountCents','amountCents','previousAssignedCents','assignedCents','changes','previousRefund','refund','actorUid','createdAt','action','entityType','entityId','before','after'])
        && op.entityType=='refund' && op.entityId==id && op.action=='refund.'+op.kind
        && op.before=={'incomeId':op.incomeId,'movementId':op.originalMovementId,'amountCents':op.previousAmountCents}
        && op.after=={'incomeId':op.incomeId,'movementId':op.targetMovementId,'amountCents':op.amountCents}
        && op.kind in ['create','cancel','correct'] && op.incomeId is string
        && op.previousAmountCents is int && op.amountCents is int && op.previousAssignedCents is int && op.assignedCents is int
        && op.actorUid==request.auth.uid && op.createdAt==request.time
        && (old!=null || next!=null) && (old==null || old.incomeId==op.incomeId)
        && (next==null || validRefundPlan(next) && next.incomeId==op.incomeId)
        && op.previousAmountCents==(old==null ? 0 : old.unallocatedCents+op.previousAssignedCents)
        && op.amountCents==(next==null ? 0 : next.unallocatedCents+op.assignedCents)
        && (old!=null || op.previousAssignedCents==0) && op.assignedCents==(next==null ? 0 : refundAssigned(next,op.changes))
        && balance.lastRefundOperationId==id && balance.updatedAt==request.time
