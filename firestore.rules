    function refundTargetTransition(groupId,id,op) {
      let target=getAfter(movementPath(groupId,op.targetMovementId)).data;
      return target.status=='active' && target.createdAt==request.time && target.lastRefundOperationId==id
        && target.get('refund',null)==op.refund && op.amountCents==(op.refund==null ? 0 : target.amountCents)
        && (op.kind=='create' ? op.originalMovementId==null && op.previousRefund==null && target.get('correctionOfMovementId',null)==null
