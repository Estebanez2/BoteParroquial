rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function accountClosing(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/accountLifecycle/current);
    }
    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt', 'lastSignInAt','lastAuditEventId'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 256
        && data.displayName.matches('.*\\S.*')
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 320))
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('lastSignInAt' in data) || data.lastSignInAt == null || data.lastSignInAt is timestamp)
        && (!('lastAuditEventId' in data) || data.lastAuditEventId is string);
    }
    match /users/{uid} {
      allow get: if ownsProfile(uid) && !accountClosing(uid);
      allow create: if ownsProfile(uid) && !accountClosing(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSignInAt == request.time;
      allow update: if ownsProfile(uid) && !accountClosing(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.displayName == resource.data.displayName
          ? request.resource.data.get('lastAuditEventId',null) == resource.data.get('lastAuditEventId',null)
          : profileRename(uid,request.resource.data,resource.data))
        && (request.resource.data.get('lastSignInAt',null) == request.time
          || request.resource.data.get('lastSignInAt',null) == resource.data.get('lastSignInAt',null));
      allow delete: if ownsProfile(uid) && recentAuthentication() && accountClosing(uid);
      allow list: if false;
    }
    function profileRename(uid,data,before) {
      let path = /databases/$(database)/documents/users/$(uid)/auditEvents/$(data.lastAuditEventId);
      let event = getAfter(path).data;
      return !exists(path) && event.action == 'profile.renamed' && event.entityType == 'profile'
        && event.entityId == uid && event.actorUid == uid && event.createdAt == request.time
        && event.before == {'displayName':before.displayName} && event.after == {'displayName':data.displayName};
    }
    function validPhotoAudit(eventId,data) {
      let after = data.after;
      return data.keys().hasAll(['action','entityType','entityId','actorUid','createdAt','before','after'])
        && data.keys().hasOnly(['action','entityType','entityId','actorUid','createdAt','before','after'])
        && data.entityType == 'photo' && data.actorUid == request.auth.uid && data.createdAt == request.time
        && data.entityId == after.targetId && after.targetId is string && after.targetId.size()>0 && after.targetId.size()<=128
        && after.keys().hasAll(['operationId','mode','targetKind','targetId','fingerprint'])
        && after.keys().hasOnly(['operationId','mode','targetKind','targetId','fingerprint'])
        && after.operationId.matches('^[a-f0-9]{32}$') && after.mode in ['upload','remove']
        && after.targetKind in ['account','group','member','person']
        && (after.mode=='remove'?after.fingerprint==null:after.fingerprint.matches('^[a-f0-9]{64}$'))
        && data.before.keys().hasAll(['fingerprint']) && data.before.keys().hasOnly(['fingerprint'])
        && (data.before.fingerprint==null||data.before.fingerprint.matches('^[a-f0-9]{64}$'))
        && ((eventId=='photo-request-'+after.operationId && data.action=='photo.changeRequested')
          || (eventId=='photo-complete-'+after.operationId && data.action=='photo.changeCompleted'));
    }
    function photoCompletionMatches(path,data) {
      let requestEvent = get(path).data;
      return requestEvent.action=='photo.changeRequested' && requestEvent.actorUid==request.auth.uid
        && requestEvent.before==data.before && requestEvent.after==data.after;
    }
    function groupPhotoAllowed(groupId,kind,id) {
      let actor=get(memberPath(groupId,request.auth.uid)).data;
      return activeMember(groupId) && (kind=='group' && id==groupId && actor.role=='owner'
        || kind=='person' && managesPersons(groupId) && get(personPath(groupId,id)).data.get('trashedAt',null)==null
        || kind=='member' && get(memberPath(groupId,id)).data.status=='active'
          && (id==request.auth.uid || actor.role=='owner' || managesPersons(groupId) && get(memberPath(groupId,id)).data.role=='member'));
    }
    match /users/{uid}/auditEvents/{eventId} {
      allow read: if ownsProfile(uid);
      allow create: if ownsProfile(uid) && !accountClosing(uid)
        && ((request.resource.data.action=='profile.renamed'
          && request.resource.data.keys().hasAll(['action','entityType','entityId','actorUid','createdAt','before','after'])
          && request.resource.data.keys().hasOnly(['action','entityType','entityId','actorUid','createdAt','before','after'])
          && request.resource.data.entityType=='profile' && request.resource.data.entityId==uid
          && request.resource.data.actorUid==uid && request.resource.data.createdAt==request.time
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastAuditEventId==eventId
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.updatedAt==request.time
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName!=get(/databases/$(database)/documents/users/$(uid)).data.displayName
          && request.resource.data.before=={'displayName':get(/databases/$(database)/documents/users/$(uid)).data.displayName}
          && request.resource.data.after=={'displayName':getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName})
        || (validPhotoAudit(eventId,request.resource.data) && request.resource.data.after.targetKind=='account'
          && request.resource.data.after.targetId==uid && (request.resource.data.action=='photo.changeRequested'
            || photoCompletionMatches(/databases/$(database)/documents/users/$(uid)/auditEvents/$(('photo-request-'+request.resource.data.after.operationId)),request.resource.data))));
      allow delete: if ownsProfile(uid) && recentAuthentication() && accountClosing(uid);
      allow update: if false;
    }
    match /users/{uid}/accountLifecycle/{id} {
      allow get: if ownsProfile(uid) && id == 'current';
      allow create: if ownsProfile(uid) && id == 'current' && recentAuthentication()
        && request.resource.data.keys().hasAll(['groupIds','createdAt','status'])
        && request.resource.data.keys().hasOnly(['groupIds','createdAt','status'])
        && request.resource.data.groupIds is list && request.resource.data.groupIds.size() <= 1000
        && request.resource.data.status == 'preparing' && request.resource.data.createdAt == request.time;
      allow update: if ownsProfile(uid) && id == 'current' && recentAuthentication()
        && resource.data.status == 'preparing' && request.resource.data.status == 'closing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','groupIds','closingAt'])
        && request.resource.data.closingAt == request.time && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 1000;
      allow delete: if ownsProfile(uid) && id == 'current' && recentAuthentication() && resource.data.status == 'preparing';
      allow list: if false;
    }
    match /users/{uid}/groupDeletionTasks/{groupId} {
      allow get, list: if ownsProfile(uid);
      allow create: if ownsProfile(uid) && recentAuthentication()
        && request.resource.data.keys().hasAll(['groupName','createdAt','status'])
        && request.resource.data.keys().hasOnly(['groupName','createdAt','status'])
        && request.resource.data.status == 'deleting' && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.deletionBy == uid
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.deletionStartedAt == request.time
        && request.resource.data.groupName == getAfter(/databases/$(database)/documents/groups/$(groupId)).data.name;
      allow update: if ownsProfile(uid) && deletingGroup(groupId)
        && resource.data.status == 'deleting' && request.resource.data.status == 'done'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && !existsAfter(/databases/$(database)/documents/groups/$(groupId));
      allow delete: if false;
    }
    match /users/{uid}/pushDevices/{deviceId} {
      function validDevice() {
        let data = request.resource.data;
        return deviceId.matches('^[a-f0-9]{64}$')
          && data.keys().hasAll(['token','platform','createdAt','updatedAt'])
          && data.keys().hasOnly(['token','platform','createdAt','updatedAt'])
          && data.token is string && data.token.size() >= 16 && data.token.size() <= 4096
          && data.platform in ['android','ios']
          && data.createdAt is timestamp && data.updatedAt == request.time;
      }
      allow get, list, delete: if ownsProfile(uid);
      allow create: if ownsProfile(uid) && !accountClosing(uid) && validDevice() && request.resource.data.createdAt == request.time;
      allow update: if ownsProfile(uid) && !accountClosing(uid) && validDevice()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /groups/{groupId}/members/{uid}/notificationPreferences/{preferenceId} {
      allow get: if preferenceId in ['reminders','economic','informative'] && ownsProfile(uid) && activeMember(groupId);
      allow create, update: if preferenceId == 'reminders' && ownsProfile(uid) && activeMember(groupId)
        && request.resource.data.keys().hasAll(['quotaPushEnabled','updatedAt'])
        && request.resource.data.keys().hasOnly(['quotaPushEnabled','updatedAt'])
        && request.resource.data.quotaPushEnabled is bool
        && request.resource.data.updatedAt == request.time;
      allow create, update: if preferenceId in ['economic','informative'] && ownsProfile(uid) && activeMember(groupId)
        && request.resource.data.keys().hasAll(['pushEnabled','updatedAt'])
        && request.resource.data.keys().hasOnly(['pushEnabled','updatedAt'])
        && request.resource.data.pushEnabled is bool
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    match /groups/{groupId}/notifications/{notificationId} {
      allow get: if activeMember(groupId) && resource.data.recipientUid == request.auth.uid;
      allow list: if activeMember(groupId) && resource.data.recipientUid == request.auth.uid
        && request.query.limit <= 50;
      allow update: if activeMember(groupId) && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && resource.data.readAt == null && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }
    function activeMember(groupId) {
      let membership = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return request.auth != null
        && exists(membership)
        && get(membership).data.uid == request.auth.uid
        && get(membership).data.status == 'active'
        && get(membership).data.role in ['owner', 'admin', 'member']
        && get(/databases/$(database)/documents/groups/$(groupId)).data.isActive == true;
    }
    // Discovery is restricted to one's own membership records, never group data.
    function managesPersons(groupId) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return activeMember(groupId) && (member.role == 'owner'
        || (member.role == 'admin' && member.personId is string
          && get(/databases/$(database)/documents/groups/$(groupId)/persons/$(member.personId)).data.isActive == true));
    }
    function newOwnGroup(groupId) {
      let path = /databases/$(database)/documents/groups/$(groupId);
      return request.auth != null && !exists(path)
        && getAfter(path).data.createdBy == request.auth.uid
        && getAfter(path).data.createdAt == request.time
        && getAfter(path).data.isActive == true;
    }
    function validGroupIdentity(data) {
      return data.name is string && data.name.size() <= 256 && data.name.matches('.*\\S.*')
        && (!('description' in data) || data.description == null
          || (data.description is string && data.description.size() <= 2000));
    }
    function initialOwner(groupId, data) {
      return data.keys().hasAll(['uid','displayName','role','status','joinedAt','updatedAt','personId'])
        && data.keys().hasOnly(['uid','displayName','role','status','joinedAt','updatedAt','personId'])
        && data.uid == request.auth.uid && data.role == 'owner' && data.status == 'active'
        && data.displayName is string && data.displayName.size() <= 256 && data.displayName.matches('.*\\S.*')
        && data.joinedAt == request.time && data.updatedAt == request.time
        && (data.personId == null || (data.personId == 'owner'
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/persons/owner).data.isActive == true
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/persons/owner).data.displayName == data.displayName
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/persons/owner).data.linkedUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/persons/owner).data.createdBy == request.auth.uid));
    }
    function groupIdentity(data) {
      return {'name': data.name, 'description': data.get('description',null)};
    }
    function groupAudit(groupId, data, action, before) {
      let event = getAfter(/databases/$(database)/documents/groups/$(groupId)/auditEvents/$(data.lastAuditEventId)).data;
      return event.action == action && event.actorUid == request.auth.uid
        && event.entityId == groupId && event.createdAt == request.time
        && event.before == before && event.after == groupIdentity(data);
    }
    function validPerson(data) {
      return data.keys().hasAll(['displayName', 'isActive', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'notes', 'isActive', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt','linkedUid','lastAuditEventId','lastParticipationPeriodId','historyGuardVersion','firstMovementId','trashedAt','trashedBy','trashedWasActive','purgingAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 256
        && data.displayName.matches('.*\\S.*')
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && data.isActive is bool && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (data.get('linkedUid',null) == null || (data.linkedUid is string && data.linkedUid.size() > 0 && data.linkedUid.size() <= 128))
        && (!('lastAuditEventId' in data) || data.lastAuditEventId is string)
        && (data.get('lastParticipationPeriodId',null) == null || (data.lastParticipationPeriodId is string && data.lastParticipationPeriodId.size() > 0 && data.lastParticipationPeriodId.size() <= 128))
        && (!('historyGuardVersion' in data) || data.historyGuardVersion == 1)
        && (!('firstMovementId' in data) || (data.firstMovementId is string && data.firstMovementId.size() > 0 && data.firstMovementId.size() <= 128))
        && (!('purgingAt' in data) || (data.purgingAt is timestamp && data.get('trashedAt',null) is timestamp))
        && (!data.keys().hasAny(['trashedAt','trashedBy','trashedWasActive'])
          || (data.keys().hasAll(['trashedAt','trashedBy','trashedWasActive'])
            && data.trashedAt is timestamp && data.trashedBy is string && data.trashedWasActive is bool
            && data.isActive == false));
    }
    function personIdentity(data) {
      return {'displayName':data.displayName,'notes':data.get('notes',null),'isActive':data.isActive};
    }
    function personTrace(groupId, personId, data, action, before) {
      let path = /databases/$(database)/documents/groups/$(groupId)/auditEvents/$(data.lastAuditEventId);
      let event = getAfter(path).data;
      return !exists(path) && event.action == action && event.entityType == 'person'
        && event.entityId == personId && event.actorUid == request.auth.uid && event.createdAt == request.time
        && event.before == before && event.after == personIdentity(data);
    }
    function trashEligible(groupId, personId, data) {
      return data.get('historyGuardVersion',0) == 1 && data.get('linkedUid',null) == null
        && data.get('lastParticipationPeriodId',null) == null && data.get('firstMovementId',null) == null;
    }
    function changedTrash(groupId, personId, before, data) {
      return trashEligible(groupId,personId,before)
        && data.diff(before).affectedKeys().hasOnly(['isActive','trashedAt','trashedBy','trashedWasActive','updatedBy','updatedAt','lastAuditEventId'])
        && ((before.get('trashedAt',null) == null && data.get('trashedAt',null) == request.time
            && data.trashedBy == request.auth.uid && data.trashedWasActive == before.isActive
            && personTrace(groupId,personId,data,'person.trashed',personIdentity(before)))
          || (before.get('trashedAt',null) != null && request.time < before.trashedAt + duration.value(10,'d')
            && !data.keys().hasAny(['trashedAt','trashedBy','trashedWasActive'])
            && data.isActive == before.trashedWasActive
            && personTrace(groupId,personId,data,'person.restored',personIdentity(before))));
    }
    function purgedPerson(groupId,personId) {
      let person = get(personPath(groupId,personId)).data;
      return managesPersons(groupId) && trashEligible(groupId,personId,person)
        && person.get('trashedAt',null) != null && request.time >= person.trashedAt + duration.value(10,'d');
    }
    function movementIdentity(data) {
      return {'type':data.type,'amountCents':data.amountCents,'personId':data.personId,'occurredAt':data.occurredAt,
        'description':data.description,'status':data.status,'correctionOfMovementId':data.get('correctionOfMovementId',null),
        'correctedByMovementId':data.get('correctedByMovementId',null),'cancellationReason':data.get('cancellationReason',null),'correctionReason':data.get('correctionReason',null)};
    }
    function movementTrace(groupId,id,data,operation,before) {
      let path = /databases/$(database)/documents/groups/$(groupId)/auditEvents/$(('movement-'+operation+'-'+id));
      let event = getAfter(path).data;
      return !exists(path) && event.action == 'movement.'+operation && event.entityType == 'movement' && event.entityId == id
        && event.actorUid == request.auth.uid && event.createdAt == request.time
        && event.before == before && event.after == movementIdentity(data);
    }
    function traceEvent(groupId,eventId,event) {
      let type = event.get('entityType','group');
      let id = event.entityId;
      let person = personPath(groupId,id);
      let movement = movementPath(groupId,id);
      return (type == 'person' && managesPersons(groupId)
          && ((event.action in ['person.created','person.updated','person.activated','person.trashed','person.restored']
              && getAfter(person).data.lastAuditEventId == eventId && getAfter(person).data.updatedAt == request.time
              && event.before == (exists(person)?personIdentity(get(person).data):null)
              && event.after == personIdentity(getAfter(person).data))
            || (event.action == 'person.purged' && eventId == 'person-purged-'+id && purgedPerson(groupId,id)
              && !existsAfter(person) && event.before == personIdentity(get(person).data) && event.after == null)))
        || (type == 'movement' && managesPersons(groupId)
          && ((event.action == 'movement.created' && eventId == 'movement-created-'+id && !exists(movement)
              && getAfter(movement).data.get('refund',null) == null && getAfter(movement).data.createdAt == request.time && event.before == null)
            || (event.action in ['movement.cancelled','movement.corrected'] && eventId == (event.action == 'movement.cancelled'?'movement-cancelled-':'movement-corrected-')+id
              && get(movement).data.get('refund',null) == null && get(movement).data.status == 'active'
              && getAfter(movement).data.status == (event.action == 'movement.cancelled'?'cancelled':'corrected')
              && getAfter(movement).data.updatedAt == request.time && event.before == movementIdentity(get(movement).data)))
          && event.after == movementIdentity(getAfter(movement).data));
    }
    function movementPath(groupId, movementId) {
      return /databases/$(database)/documents/groups/$(groupId)/movements/$(movementId);
    }
    function validMovement(data) {
      return data.keys().hasAll(['type','amountCents','status','occurredAt','description','personId','createdBy','createdAt','updatedAt'])
        && data.keys().hasOnly(['type','amountCents','status','occurredAt','description','personId','createdBy','createdAt','updatedAt',
          'cancelledAt','cancelledBy','cancellationReason','correctedAt','correctedBy','correctionReason','correctedByMovementId','correctionOfMovementId','refund','lastRefundOperationId'])
        && data.type in ['income','withdrawal'] && data.status in ['active','cancelled','corrected']
        && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 99999999999999
        && data.occurredAt is timestamp && data.occurredAt >= timestamp.date(2000,1,1) && data.occurredAt < timestamp.date(2101,1,1)
        && data.occurredAt == data.occurredAt.date()
        // Civil dates use UTC midnight. Allow the timezone margin for local "today".
        && data.occurredAt <= request.time + duration.value(1,'d')
        && data.description is string && data.description.size() <= 2000
        && (data.type == 'income' || data.description.matches('.*\\S.*'))
        && (data.personId == null || (data.personId is string && data.personId.size() > 0))
        && (data.type != 'income' || data.personId is string)
        && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('correctionOfMovementId' in data) || (data.correctionOfMovementId is string && data.correctionOfMovementId.size() > 0))
        && (data.get('refund',null) == null || (data.type == 'withdrawal' && data.personId is string));
    }
    function validMovementPerson(groupId, data) {
      return data.personId == null || (getAfter(personPath(groupId,data.personId)).data.get('trashedAt',null) == null
        && (getAfter(personPath(groupId,data.personId)).data.get('historyGuardVersion',0) != 1
          || getAfter(personPath(groupId,data.personId)).data.get('firstMovementId',null) is string));
    }
    function activeMovement(data) {
      return data.status == 'active' && !data.keys().hasAny(['cancelledAt','cancelledBy','cancellationReason',
        'correctedAt','correctedBy','correctionReason','correctedByMovementId']);
    }
    function replacementCreate(groupId, movementId, data) {
      let originalPath = movementPath(groupId,data.correctionOfMovementId);
      let before = get(originalPath).data;
      let after = getAfter(originalPath).data;
      return data.correctionOfMovementId != movementId && before.status == 'active'
        && after.status == 'corrected' && after.correctedByMovementId == movementId
        && after.correctedBy == request.auth.uid && after.correctedAt == request.time;
    }
    function cancelMovement(groupId, movementId, before, after) {
      return after.status == 'cancelled'
        && after.diff(before).affectedKeys().hasOnly(['status','updatedAt','cancelledAt','cancelledBy','cancellationReason','lastRefundOperationId'])
        && after.cancelledAt == request.time && after.cancelledBy == request.auth.uid
        && after.cancellationReason is string && after.cancellationReason.size() <= 2000
        && after.cancellationReason.matches('.*\\S.*')
        && (before.get('refund',null) == null
          ? after.get('lastRefundOperationId',null) == before.get('lastRefundOperationId',null)
          : refundMovementLink(groupId,movementId,after,'cancel',false));
    }
    function correctMovement(groupId, movementId, before, after) {
      let target = movementPath(groupId,after.correctedByMovementId);
      let replacement = getAfter(target).data;
      return after.status == 'corrected' && after.correctedByMovementId != movementId
        && after.diff(before).affectedKeys().hasOnly(['status','updatedAt','correctedAt','correctedBy','correctionReason','correctedByMovementId','lastRefundOperationId'])
        && after.correctedAt == request.time && after.correctedBy == request.auth.uid
        && after.correctionReason is string && after.correctionReason.size() <= 2000 && after.correctionReason.matches('.*\\S.*')
        && !exists(target) && replacement.status == 'active'
        && replacement.correctionOfMovementId == movementId
        && replacement.createdBy == request.auth.uid && replacement.createdAt == request.time
        && (before.get('refund',null) != null || replacement.get('refund',null) != null
          ? refundMovementLink(groupId,movementId,after,'correct',false)
            && replacement.lastRefundOperationId == after.lastRefundOperationId
          : after.get('lastRefundOperationId',null) == before.get('lastRefundOperationId',null));
    }
    function settingsPath(groupId) { return /databases/$(database)/documents/groups/$(groupId)/invitationSettings/current; }
    function memberPath(groupId, uid) { return /databases/$(database)/documents/groups/$(groupId)/members/$(uid); }
    function joinPath(groupId, uid) { return /databases/$(database)/documents/groups/$(groupId)/joinRequests/$(uid); }
    function settingsSummary(data) { return {'enabled':data.enabled,'requiresApproval':data.requiresApproval}; }
    function requestSummary(data) { return {'uid':data.uid,'displayName':data.displayName,'status':data.status}; }
    function memberSummary(data) { return {'uid':data.uid,'role':data.role,'status':data.status,'personId':data.get('personId',null)}; }
    function linkSummary(data) { return {'uid':data.uid,'personId':data.get('personId',null),'role':data.role}; }
    function hasActiveLinkedPerson(groupId, data) {
      return data.get('personId',null) is string
        && get(personPath(groupId,data.personId)).data.isActive == true
        && get(personPath(groupId,data.personId)).data.get('linkedUid',null) == data.uid
        && getAfter(personPath(groupId,data.personId)).data.isActive == true
        && getAfter(personPath(groupId,data.personId)).data.get('linkedUid',null) == data.uid;
    }
