    function refundMovementLink(groupId,id,data,kind,target) {
      let path=refundPath(groupId,data.lastRefundOperationId);
      let op=getAfter(path).data;
      return !exists(path) && op.createdAt==request.time && op.actorUid==request.auth.uid && op.kind==kind
        && (target ? op.targetMovementId==id : op.originalMovementId==id)
        && (!(target || kind=='cancel') || lastRefundMonth(groupId,op));
    }
    function lastRefundMonth(groupId,op) {
      let path=allocationBalancePath(groupId,op.incomeId);
      let prior=exists(path) ? get(path).data.get('refundedMonths',{}) : {};
      return refundMonthChange(groupId,op,prior,getAfter(path).data.refundedMonths,
