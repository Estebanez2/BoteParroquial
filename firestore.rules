        allow delete: if false;
      }
      match /persons/{personId} {
        allow read: if activeMember(groupId);
        allow create: if ((managesPersons(groupId) && request.resource.data.get('linkedUid',null) == null)
          || (newOwnGroup(groupId) && personId == 'owner' && request.resource.data.linkedUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.personId == personId)) && validPerson(request.resource.data)
          && ((newOwnGroup(groupId) && !('lastAuditEventId' in request.resource.data))
            || (request.resource.data.get('historyGuardVersion',0) != 1 && !('lastAuditEventId' in request.resource.data)
              && request.resource.data.get('lastParticipationPeriodId',null) == null)
            || personTrace(groupId,personId,request.resource.data,'person.created',null)
            || createdParticipation(groupId,personId,request.resource.data))
          && request.resource.data.get('trashedAt',null) == null
          && request.resource.data.get('firstMovementId',null) == null
          && request.resource.data.isActive == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if managesPersons(groupId) && validPerson(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (changedTrash(groupId,personId,resource.data,request.resource.data)
            || (resource.data.get('trashedAt',null) == null && request.resource.data.get('trashedAt',null) == null
            && (changedPersonLink(groupId,personId,resource.data,request.resource.data)
            || startedParticipation(groupId,personId,resource.data,request.resource.data)
            || (request.resource.data.get('linkedUid',null) == resource.data.get('linkedUid',null)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','notes','isActive','updatedAt','updatedBy','lastAuditEventId'])
              && (resource.data.isActive == true && request.resource.data.isActive == false
                ? inactivatedPerson(groupId,personId,resource.data,request.resource.data)
                : !(resource.data.isActive == false && request.resource.data.isActive == true && resource.data.get('lastParticipationPeriodId',null) != null)
                  && personTrace(groupId,personId,request.resource.data,
                    resource.data.isActive == false && request.resource.data.isActive == true?'person.activated':'person.updated',personIdentity(resource.data)))))));
        allow delete: if purgedPerson(groupId,personId)
          && resource.data.get('purgingAt',null) is timestamp
          && !exists(/databases/$(database)/documents/groups/$(groupId)/auditEvents/$(('person-purged-'+personId)))
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/auditEvents/$(('person-purged-'+personId))).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/auditEvents/$(('person-purged-'+personId))).data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/auditEvents/$(('person-purged-'+personId))).data.action == 'person.purged';
      }
      // Monotonic history witness, written with the first movement. It cannot
      // be removed when that movement is cancelled or corrected.
      match /persons/{personId} {
        allow update: if purgedPerson(groupId,personId) && validPerson(request.resource.data)
          && resource.data.get('purgingAt',null) == null && request.resource.data.purgingAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purgingAt']);
        allow update: if managesPersons(groupId) && validPerson(request.resource.data)
          && resource.data.get('trashedAt',null) == null && resource.data.get('firstMovementId',null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstMovementId'])
          && request.resource.data.firstMovementId is string
          && !exists(movementPath(groupId,request.resource.data.firstMovementId))
          && getAfter(movementPath(groupId,request.resource.data.firstMovementId)).data.personId == personId
          && getAfter(movementPath(groupId,request.resource.data.firstMovementId)).data.createdAt == request.time;
      }
      match /movements/{movementId} {
        allow read: if activeMember(groupId);
        allow create: if request.method=='create' && managesPersons(groupId) && validMovement(request.resource.data)
          && refundCreateLink(groupId,movementId,request.resource.data)
          && validMovementPerson(groupId,request.resource.data) && activeMovement(request.resource.data)
          && (request.resource.data.get('refund',null) != null || movementTrace(groupId,movementId,request.resource.data,'created',null))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && (!('correctionOfMovementId' in request.resource.data) || replacementCreate(groupId,movementId,request.resource.data));
        allow update: if request.method=='update' && managesPersons(groupId) && resource.data.status == 'active'
          && (resource.data.type!='income' || !exists(allocationBalancePath(groupId,movementId))
            || get(allocationBalancePath(groupId,movementId)).data.get('refundedCents',0)==0)
          && request.resource.data.updatedAt == request.time
          && (resource.data.get('refund',null) != null || movementTrace(groupId,movementId,request.resource.data,
            request.resource.data.status == 'cancelled'?'cancelled':'corrected',movementIdentity(resource.data)))
          && (cancelMovement(groupId,movementId,resource.data,request.resource.data)
            || correctMovement(groupId,movementId,resource.data,request.resource.data));
        allow delete: if false;
      }
    }
    // Explicit irreversible group deletion is the only exception to economic
    // immutability. The root lock remains until all descendant cleanup finishes.
    match /groups/{groupId}/{collectionId}/{documentId}/{nested=**} {
      allow read: if deletingGroup(groupId);
      allow delete: if deletingGroup(groupId)
        && request.time >= get(/databases/$(database)/documents/groups/$(groupId)).data.deletionStartedAt + duration.value(3,'m');
    }
    // Future collections remain closed until their phases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
