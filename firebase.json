{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "boteparroquial",
          "appId": "1:146917525912:android:19e9cd4589791d82a103ed",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "boteparroquial",
          "configurations": {
            "android": "1:146917525912:android:19e9cd4589791d82a103ed",
            "ios": "1:146917525912:ios:1ce7c8765b923fe3a103ed"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "boteparroquial",
    "public": "hosting/public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [{"source": "/join/**", "destination": "/index.html"}],
    "headers": [
      {"source": "**", "headers": [
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}
      ]},
      {"source": "/.well-known/assetlinks.json", "headers": [
        {"key": "Content-Type", "value": "application/json"},
        {"key": "Cache-Control", "value": "public,max-age=300"}
      ]}
    ]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
